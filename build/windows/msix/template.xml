<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="bookmarks-manager.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Hunlongyu\Bookmarks Manager">
    </Installer>
    <PackageInformation
        PackageName="Bookmarks Manager"
        PackageDisplayName="Bookmarks Manager"
        PublisherName="CN=Hunlongyu"
        PublisherDisplayName="Hunlongyu"
        Version="0.1.0.0"
        PackageDescription="本地优先的桌面书签管理器">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="io.github.hunlongyu.bookmarksmanager"
                Description="本地优先的桌面书签管理器"
                DisplayName="Bookmarks Manager"
                ExecutableName="bookmarks-manager.exe"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Bookmarks Manager</DisplayName>
            <PublisherDisplayName>Hunlongyu</PublisherDisplayName>
            <Description>本地优先的桌面书签管理器</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="bookmarks-manager.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
