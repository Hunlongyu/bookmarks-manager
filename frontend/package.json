{
  "name": "bookmarks-manager-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "tsc && vite build --minify false --mode development",
    "build": "tsc && vite build --mode production",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prototype:dev": "vite --config ../原型/vite.config.ts",
    "prototype:build": "node ../原型/scripts/build.mjs",
    "prototype:check": "tsc --project ../原型/tsconfig.json"
  },
  "dependencies": {
    "@radix-ui/themes": "3.3.0",
    "@wailsio/runtime": "3.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@radix-ui/react-icons": "1.3.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.2.2",
    "vite": "^8.2.4"
  },
  "packageManager": "pnpm@12.16.1"
}
