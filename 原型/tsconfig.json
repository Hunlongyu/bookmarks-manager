{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "typeRoots": ["../frontend/node_modules/@types"],
    "paths": {
      "react": ["../frontend/node_modules/@types/react"],
      "react/*": ["../frontend/node_modules/@types/react/*"],
      "react-dom/*": ["../frontend/node_modules/@types/react-dom/*"],
      "@radix-ui/themes": ["../frontend/node_modules/@radix-ui/themes"],
      "@radix-ui/react-icons": ["../frontend/node_modules/@radix-ui/react-icons"]
    }
  },
  "include": ["src"]
}
