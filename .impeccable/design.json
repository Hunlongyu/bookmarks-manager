  "narrative": {
    "northStar": "书签整理工作台",
    "overview": "界面围绕目录、书签列表与检查依据展开。冷灰侧栏与内容面形成稳定层级，靛蓝只承担主操作、当前选择和建议结果；紧凑排版让用户连续比较、确认并应用变更。\n\n使用实际 Radix Themes 3.3.0，主题配置为 Indigo、Slate、medium 圆角和 100% 缩放。系统中文字体服务于 Windows 桌面阅读，浅色和深色保留相同的信息顺序。这里记录交互原型的视觉系统；真实业务实现状态以 PRODUCT.md 与原型说明为准。",
    "keyCharacteristics": [
      "目录、列表、详情形成连续工作区。",
      "细分隔线、浅色块和紧凑行距组织内容。",
      "颜色、文字与操作依据共同表达状态。",
      "桌面窗口自由缩放，滚动区与固定操作区保持明确分工。"
    ],
    "rules": [
      {
        "name": "语义优先",
        "body": "靛蓝表示操作与选择；绿色、琥珀色、橙色、红色分别表达通过、跳转、需关注与失效。状态必须保留文字，未检查使用灰色。",
        "section": "colors"
      },
      {
        "name": "平面优先",
        "body": "常驻区域以底色和细边界分层，浮层阴影只说明菜单、弹窗与通知的遮挡关系。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 使用真实 Radix 控件及其主题变量，保留键盘焦点与禁用状态。",
      "Do 在预览中并列呈现原值、依据和建议结果，长地址允许换行。",
      "Do 维持深浅主题的角色对应，按内容容器空间切换详情栏与详情弹窗，保留固定的底部操作入口。"
    ],
    "donts": [
      "Don't 引入 Material 3 作为第二套组件外观。",
      "Don't 将语义状态色用于无关装饰，或仅用颜色表示检查结果。",
      "Don't 把原型的固定演示结果描述成已接通浏览器、网络或 AI 服务。"
    ]
  }
}
